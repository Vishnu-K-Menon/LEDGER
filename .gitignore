.venv/
__pycache__/
*.pyc
.env
# data/ is local except the reproducibility records below. `data/*` (not `data/`) so the
# negations work: git never descends into a fully excluded directory.
data/*
!data/chunk_ids.lock
!data/index_meta.json
!data/frames/
!data/sources.yaml
!data/manifest.jsonl
# T5 (D-043): the draw record and the owner-checked draft questions are reproducibility records.
!data/questions_draft.jsonl
!data/questions_draft_draw.json
!data/questions_draft_draw_run1.json
!data/controls_accepted.json
# The A1 cell oracle (D-038): publisher files stay local; each snapshot's hash manifest is tracked,
# because reproducibility rests on the hashes, not on committing EIA's and GovInfo's files.
!data/oracle/
data/oracle/**
!data/oracle/**/
!data/oracle/**/sources.json
!data/oracle/**/footnotes.json
!data/oracle/**/unit_aliases.json
!data/oracle/**/admission_rule.md
!data/oracle/**/erp_draw.json
!data/oracle/**/freeze.json
results/
# reports/ is local, except the rung-1 records of D-038 (morning report, clock, baselines).
reports/*
!reports/a8.md
!reports/t5_*.md
!reports/a1_diag/
reports/a1_diag/*
!reports/a1_diag/rung1/
!reports/a1_diag/rung1b/
logs/
