.venv/
__pycache__/
*.pyc
.env
# data/ is local except the reproducibility records below. `data/*` (not `data/`) so the
# negations work: git never descends into a fully excluded directory.
data/*
!data/chunk_ids.lock
!data/frames/
!data/sources.yaml
!data/manifest.jsonl
# The A1 cell oracle (D-038): publisher files stay local; each snapshot's hash manifest is tracked,
# because reproducibility rests on the hashes, not on committing EIA's and GovInfo's files.
!data/oracle/
data/oracle/**
!data/oracle/**/
!data/oracle/**/sources.json
!data/oracle/**/footnotes.json
!data/oracle/**/unit_aliases.json
results/
reports/
logs/
